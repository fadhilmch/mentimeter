{
  "name": "crowdflow",
  "version": "2.0.0",
  "private": true,
  "description": "Open-source interactive real-time presentations: audiences join with a 6-digit code and take part live.",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:memory": "npm --prefix server run dev:memory",
    "test": "npm --prefix server test && npm --prefix client test",
    "build": "npm --prefix client run build",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
