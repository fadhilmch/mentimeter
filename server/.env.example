# Required in production
MONGODB_URI=mongodb://127.0.0.1:27017/livepoll
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=3000
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_DIST=../client/dist   # serve the built client from this server

# Access-code generation tuning
ACCESS_CODE_LENGTH=6
ACCESS_CODE_ALPHABET=0123456789
ACCESS_CODE_MAX_ATTEMPTS=25

# Ably realtime (serverless hosting). Leave unset to use self-hosted Socket.IO only.
# ABLY_API_KEY=xxxx:yyyy

# Firebase Authentication (optional). Leave unset to keep the built-in username login.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=                                         # public web API key; needed to check token revocation without a service account
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # optional: without it the browser deletes its own Firebase login
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099                # local emulator, no real project
# FIREBASE_RECENT_SIGN_IN_SECONDS=300
