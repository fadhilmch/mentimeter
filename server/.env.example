# Required in production
MONGODB_URI=mongodb://127.0.0.1:27017/livepoll
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=3000
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_DIST=../client/dist   # serve the built client from this server

# Access-code generation tuning
ACCESS_CODE_LENGTH=6
ACCESS_CODE_ALPHABET=0123456789
ACCESS_CODE_MAX_ATTEMPTS=25

# Ably realtime (serverless hosting). Leave unset to use self-hosted Socket.IO only.
# ABLY_API_KEY=xxxx:yyyy
