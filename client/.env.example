# Default (self-hosted): leave unset - the dev proxy or same-origin server handles /api and /socket.io
# VITE_API_URL=http://localhost:3000
# VITE_SOCKET_URL=http://localhost:3000

# Serverless (Vercel + Ably): same-origin API, realtime over Ably
# VITE_LIVE_MODE=ably

# Firebase Authentication (optional; leave unset to keep the built-in username login).
# These identify the project to the browser and are not secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=            # defaults to <project>.firebaseapp.com
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099   # local emulator only
